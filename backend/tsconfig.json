{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@controllers/*": ["./src/controllers/*"],
      "@models/*":      ["./src/models/*"],
      "@middleware/*":  ["./src/middleware/*"],
      "@services/*":    ["./src/services/*"],
      "@utils/*":       ["./src/utils/*"],
      "@config/*":      ["./src/config/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules","dist"]
}
